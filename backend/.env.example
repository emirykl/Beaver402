# Copy to .env and fill in. Never commit the filled in file.
# Running scripts/setup-keys.sh writes the Stellar values for you.

# ── Network ───────────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# The policy account. Written by scripts/deploy.sh.
POLICY_CONTRACT_ID=

# ── Keys ──────────────────────────────────────────────────────────
# Pays the fee for owner actions. It cannot approve anything, because
# the owner is a passkey and the contract checks the passkey instead.
FEE_SOURCE_SECRET=

# The delegated signer. Spends from the policy account within the
# limits the contract enforces.
AGENT_SECRET=

# Signs the demo merchant's payment challenges.
MERCHANT_SECRET=

# Where a demo payment lands.
RECIPIENT_ADDRESS=

# The token contract payments settle through. Testnet USDC by default.
USDC_ISSUER=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# ── Passkey ───────────────────────────────────────────────────────
# A passkey is bound to the domain it was registered on, so these have
# to match wherever the control panel is served from.
RP_ID=localhost
ORIGIN=http://localhost:5403

# ── Storage ───────────────────────────────────────────────────────
# Passkey credentials, sessions and the payment log.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Server ────────────────────────────────────────────────────────
PORT=5402
