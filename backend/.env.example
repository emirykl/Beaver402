# ── Stellar / Soroban ──────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract ID (set after deployment)
POLICY_CONTRACT_ID=

# Owner keypair — used for freeze / restore / revoke operations
OWNER_SECRET=

# ── Merchant ──────────────────────────────────────────────────────
# Merchant keypair — signs payment challenges
MERCHANT_SECRET=

# Payment recipient address (defaults to merchant public key)
RECIPIENT_ADDRESS=

# USDC token contract on testnet
USDC_ISSUER=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# ── WebAuthn / Passkey ────────────────────────────────────────────
RP_ID=localhost
ORIGIN=http://localhost:5173
CREDENTIAL_STORE=.beaver402-credentials.json

# ── Supabase ──────────────────────────────────────────────────────
# Project URL  → Supabase Dashboard > Settings > API > Project URL
SUPABASE_URL=

# Anon key     → Supabase Dashboard > Settings > API > Project API keys > anon public
SUPABASE_ANON_KEY=

# Service key  → Supabase Dashboard > Settings > API > Project API keys > service_role secret
# (backend only — never expose to frontend)
SUPABASE_SERVICE_KEY=

# ── Server ────────────────────────────────────────────────────────
PORT=3000
