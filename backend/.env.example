# Copy to .env and fill in. Never commit the filled in file.
# Running scripts/setup-keys.sh writes the Stellar values for you.
# For mainnet the same names go in .env.mainnet, or in the host's settings.

# ── Network ───────────────────────────────────────────────────────
# testnet or mainnet. Everything else about the network follows from it:
# the passphrase, the USDC contract, the explorer and the facilitator.
BEAVER_NETWORK=testnet

# Optional on testnet, required on mainnet. The backend checks that the
# endpoint really serves the network above before it signs anything.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# The policy account. Written by scripts/deploy.sh.
POLICY_CONTRACT_ID=

# ── What this process runs ────────────────────────────────────────
# agent, merchant, or all. "all" runs both halves in one process and is
# only accepted on testnet. On mainnet the agent and the merchant are
# separate deployments, each holding only its own secret.
BEAVER402_ROLE=all

# ── Agent ─────────────────────────────────────────────────────────
# The delegated signer. Spends from the policy account within the
# limits the contract enforces.
AGENT_SECRET=

# Pays the fee for owner actions. It cannot approve anything, because
# the owner is a passkey and the contract checks the passkey instead.
FEE_SOURCE_SECRET=

# Who may ask the agent to pay. Required on mainnet: a token of at least
# 32 characters, and the merchant origins the agent may fetch from.
AGENT_API_TOKEN=
AGENT_ALLOWED_ORIGINS=

# The merchant this deployment works with, as a public key. Lets the
# panel show whether the owner has approved it without holding its secret.
MERCHANT_PUBKEY=

# ── Merchant ──────────────────────────────────────────────────────
# Signs the demo merchant's payment challenges.
MERCHANT_SECRET=

# Where a payment lands. A classic account with a USDC trustline.
# Required on mainnet; on testnet it defaults to the merchant's account.
RECIPIENT_ADDRESS=

# ── Passkey ───────────────────────────────────────────────────────
# A passkey is bound to the domain it was registered on, so these have
# to match wherever the control panel is served from. Required on
# mainnet, where ORIGIN has to be https on the RP_ID domain.
RP_ID=localhost
ORIGIN=http://localhost:5403

# ── Storage ───────────────────────────────────────────────────────
# Passkey credentials, sessions, ceremonies in progress, rate limits and
# the payment log. Run scripts/supabase-migration.sql, then
# scripts/supabase-migration-002.sql.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Server ────────────────────────────────────────────────────────
PORT=5402

# The control panel. Has to be the port ORIGIN names, because a passkey
# only works on the origin it was registered on.
FRONTEND_PORT=5403
