{
  "name": "beaver402-backend",
  "version": "0.1.0",
  "description": "Beaver402 payment security layer backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "mcp": "tsx --env-file-if-exists=.env src/mcp/server.ts",
    "vectors": "tsx scripts/generate-vectors.ts",
    "owner:key": "tsx --env-file-if-exists=.env scripts/owner-key.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "scenarios": "tsx --env-file-if-exists=.env scripts/scenarios.ts",
    "dev:mainnet": "tsx --env-file=.env.mainnet src/index.ts",
    "rehearse": "tsx --env-file-if-exists=.env scripts/rehearse.ts",
    "preflight": "tsx --env-file-if-exists=.env scripts/preflight.ts"
  },
  "keywords": [
    "stellar",
    "x402",
    "payment",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@simplewebauthn/server": "^13.3.2",
    "@stellar/stellar-sdk": "^16.3.1",
    "@supabase/supabase-js": "^2.112.2",
    "@x402/core": "2.28.0",
    "@x402/stellar": "2.28.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@stellar/stellar-sdk": {
      "axios": "1.20.0"
    }
  }
}
