# testnet or mainnet. There is no default.
BEAVER402_NETWORK=testnet

# Circle USDC on the chosen network. Print it with: npx beaver402-merchant usdc testnet
USDC_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Required on mainnet. On testnet the public RPC is used when left empty.
SOROBAN_RPC_URL=

# OpenZeppelin Channels x402 facilitator. The URL defaults to the one for the network.
FACILITATOR_URL=
FACILITATOR_API_KEY=

# The merchant signing key (S...). Make one with: npx beaver402-merchant keygen
MERCHANT_SECRET=

# Where USDC lands: a classic G account with a USDC trustline.
RECIPIENT_ADDRESS=

# The origin agents call. Required on mainnet, and behind any proxy.
PUBLIC_URL=

# Default price per request in USDC.
PRICE_USDC=0.1

# File where completed payments are recorded. Required on mainnet.
SETTLEMENT_STORE=./data/payments.jsonl

PORT=4021
